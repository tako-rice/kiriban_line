//@version=6
strategy(
     "KiriBan Pinbar Strategy EMA200 Filter",
     overlay = true,
     pyramiding = 0,
     initial_capital = 100000,
     process_orders_on_close = true
)

// ========================================
// 設定
// ========================================
stepSize = input.float(1.0, "キリ番間隔")
tpPips   = input.int(30, "利確 pips")
slPips   = input.int(30, "損切 pips")

emaLength = input.int(200, "EMA期間", minval = 1)

showLines = input.bool(true, "キリ番表示")
showEma   = input.bool(true, "200EMA表示")

pipValue = input.float(0.01, "1 pip の価格幅", step = 0.001)

tpValue = tpPips * pipValue
slValue = slPips * pipValue

// ========================================
// 200EMAフィルター
// ========================================
ema200 = ta.ema(close, emaLength)

emaUp   = ema200 > ema200[1]
emaDown = ema200 < ema200[1]

plot(
     showEma ? ema200 : na,
     title = "EMA200",
     color = color.orange,
     linewidth = 2
)

// ========================================
// キリ番計算
// ========================================
float upperLevel = math.ceil(close / stepSize) * stepSize
float lowerLevel = math.floor(close / stepSize) * stepSize

if upperLevel == lowerLevel
    upperLevel := upperLevel + stepSize
    lowerLevel := lowerLevel - stepSize

// ========================================
// ローソク足の構成
// ========================================
bodySize = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

validBody = bodySize > 0

// ========================================
// ピンバー定義
// ロング：下ヒゲ >= 実体×2、上ヒゲ <= 実体
// ショート：上ヒゲ >= 実体×2、下ヒゲ <= 実体
// ========================================
bullishPinbar =
     validBody and
     lowerWick >= bodySize * 2.0 and
     upperWick <= bodySize

bearishPinbar =
     validBody and
     upperWick >= bodySize * 2.0 and
     lowerWick <= bodySize

// ========================================
// キリ番タッチ判定
// ========================================
touchLowerLevel = low <= lowerLevel
touchUpperLevel = high >= upperLevel

// ========================================
// 一度使ったライン管理
// ========================================
var float usedLevel = na

if not na(usedLevel)
    if high >= usedLevel + stepSize or low <= usedLevel - stepSize
        usedLevel := na

bool canLong  = na(usedLevel) or usedLevel != lowerLevel
bool canShort = na(usedLevel) or usedLevel != upperLevel

// ========================================
// エントリー条件
// ========================================
longCondition =
     strategy.position_size == 0 and
     emaUp and
     touchLowerLevel and
     bullishPinbar and
     canLong

shortCondition =
     strategy.position_size == 0 and
     emaDown and
     touchUpperLevel and
     bearishPinbar and
     canShort

// ========================================
// エントリー
// ========================================
if longCondition
    strategy.entry(
         id = "Long",
         direction = strategy.long
     )

    usedLevel := lowerLevel

if shortCondition
    strategy.entry(
         id = "Short",
         direction = strategy.short
     )

    usedLevel := upperLevel

// ========================================
// 決済
// ========================================
if strategy.position_size > 0
    strategy.exit(
         id = "Long Exit",
         from_entry = "Long",
         limit = strategy.position_avg_price + tpValue,
         stop  = strategy.position_avg_price - slValue
     )

if strategy.position_size < 0
    strategy.exit(
         id = "Short Exit",
         from_entry = "Short",
         limit = strategy.position_avg_price - tpValue,
         stop  = strategy.position_avg_price + slValue
     )

// ========================================
// キリ番ライン表示
// ========================================
if showLines and barstate.islast
    line.new(
         x1 = bar_index,
         y1 = upperLevel,
         x2 = bar_index + 100,
         y2 = upperLevel,
         color = color.red,
         width = 1,
         style = line.style_solid
     )

    line.new(
         x1 = bar_index,
         y1 = lowerLevel,
         x2 = bar_index + 100,
         y2 = lowerLevel,
         color = color.red,
         width = 1,
         style = line.style_solid
     )
