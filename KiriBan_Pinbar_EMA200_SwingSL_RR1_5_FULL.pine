//@version=6
strategy(
     "KiriBan Pinbar Strategy EMA200 SwingSL RR1.5",
     overlay = true,
     pyramiding = 0,
     initial_capital = 100000,
     process_orders_on_close = true
)

// ========================================
// 設定
// ========================================
stepSize = input.float(1.0, "キリ番間隔")

emaLength = input.int(200, "EMA期間", minval = 1)

swingLeft  = input.int(6, "スイング左本数", minval = 1)
swingRight = input.int(6, "スイング右本数", minval = 1)

riskReward = input.float(1.5, "リスクリワード", step = 0.1)

showLines = input.bool(true, "キリ番表示")
showEma   = input.bool(true, "200EMA表示")

// ========================================
// ロンドン・NY時間フィルター
// ========================================
londonSession =
     not na(
         time(
              timeframe.period,
              "0800-1700",
              "Europe/London"
         )
     )

nySession =
     not na(
         time(
              timeframe.period,
              "0930-1700",
              "America/New_York"
         )
     )

tradeSession = londonSession or nySession

// ========================================
// 200EMA
// ========================================
ema200 = ta.ema(close, emaLength)

emaUp   = ema200 > ema200[1]
emaDown = ema200 < ema200[1]

plot(
     showEma ? ema200 : na,
     title = "EMA200",
     color = color.orange,
     linewidth = 2
)

// ========================================
// スイング高値・安値
// 左右6本更新しない高値/安値
// ========================================
swingHigh = ta.pivothigh(high, swingLeft, swingRight)
swingLow  = ta.pivotlow(low, swingLeft, swingRight)

var float lastSwingHigh = na
var float lastSwingLow  = na

if not na(swingHigh)
    lastSwingHigh := swingHigh

if not na(swingLow)
    lastSwingLow := swingLow

// ========================================
// キリ番計算
// ========================================
float upperLevel = math.ceil(close / stepSize) * stepSize
float lowerLevel = math.floor(close / stepSize) * stepSize

if upperLevel == lowerLevel
    upperLevel := upperLevel + stepSize
    lowerLevel := lowerLevel - stepSize

// ========================================
// ローソク足構成
// ========================================
bodySize = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

validBody = bodySize > 0

// ========================================
// ピンバー定義
// ロング：下ヒゲ >= 実体×2、上ヒゲ <= 実体
// ショート：上ヒゲ >= 実体×2、下ヒゲ <= 実体
// ========================================
bullishPinbar =
     validBody and
     lowerWick >= bodySize * 2.0 and
     upperWick <= bodySize

bearishPinbar =
     validBody and
     upperWick >= bodySize * 2.0 and
     lowerWick <= bodySize

// ========================================
// キリ番タッチ
// ========================================
touchLowerLevel = low <= lowerLevel
touchUpperLevel = high >= upperLevel

// ========================================
// 同一キリ番連続防止
// ========================================
var float usedLevel = na

if not na(usedLevel)
    if high >= usedLevel + stepSize or low <= usedLevel - stepSize
        usedLevel := na

bool canLong  = na(usedLevel) or usedLevel != lowerLevel
bool canShort = na(usedLevel) or usedLevel != upperLevel

// ========================================
// エントリー条件
// ========================================
longCondition =
     strategy.position_size == 0 and
     tradeSession and
     emaUp and
     touchLowerLevel and
     bullishPinbar and
     canLong and
     not na(lastSwingLow) and
     lastSwingLow < close

shortCondition =
     strategy.position_size == 0 and
     tradeSession and
     emaDown and
     touchUpperLevel and
     bearishPinbar and
     canShort and
     not na(lastSwingHigh) and
     lastSwingHigh > close

// ========================================
// 損切り・利確保存
// ========================================
var float longStopPrice  = na
var float longLimitPrice = na

var float shortStopPrice  = na
var float shortLimitPrice = na

// ========================================
// ロング
// 損切り：直近スイング安値
// 利確：リスク × 1.5
// ========================================
if longCondition
    float entryPrice = close
    float risk = entryPrice - lastSwingLow

    if risk > 0
        longStopPrice := lastSwingLow
        longLimitPrice := entryPrice + risk * riskReward

        strategy.entry(
             id = "Long",
             direction = strategy.long
        )

        usedLevel := lowerLevel

// ========================================
// ショート
// 損切り：直近スイング高値
// 利確：リスク × 1.5
// ========================================
if shortCondition
    float entryPrice = close
    float risk = lastSwingHigh - entryPrice

    if risk > 0
        shortStopPrice := lastSwingHigh
        shortLimitPrice := entryPrice - risk * riskReward

        strategy.entry(
             id = "Short",
             direction = strategy.short
        )

        usedLevel := upperLevel

// ========================================
// 決済
// ========================================
if strategy.position_size > 0
    strategy.exit(
         id = "Long Exit",
         from_entry = "Long",
         stop = longStopPrice,
         limit = longLimitPrice
     )

if strategy.position_size < 0
    strategy.exit(
         id = "Short Exit",
         from_entry = "Short",
         stop = shortStopPrice,
         limit = shortLimitPrice
     )

// ========================================
// キリ番ライン表示
// ========================================
if showLines and barstate.islast
    line.new(
         x1 = bar_index,
         y1 = upperLevel,
         x2 = bar_index + 100,
         y2 = upperLevel,
         color = color.red,
         width = 1,
         style = line.style_solid
     )

    line.new(
         x1 = bar_index,
         y1 = lowerLevel,
         x2 = bar_index + 100,
         y2 = lowerLevel,
         color = color.red,
         width = 1,
         style = line.style_solid
     )
