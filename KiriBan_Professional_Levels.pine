//@version=6
indicator("KiriBan Professional Levels", overlay = true, max_lines_count = 500, max_labels_count = 500)

// =====================================================
// 実践向け設定
// =====================================================
startPrice = input.float(100.0, "開始価格")
endPrice   = input.float(170.0, "終了価格")
stepSize   = input.float(0.5, "キリ番間隔", step = 0.1)

majorColor = input.color(color.white, "00ライン色")
minorColor = input.color(color.gray, "50ライン色")

majorWidth = input.int(2, "00ライン太さ", minval = 1, maxval = 5)
minorWidth = input.int(1, "50ライン太さ", minval = 1, maxval = 5)

futureBars = input.int(300, "未来へ伸ばす本数", minval = 50, maxval = 1000)

showLabels = input.bool(true, "価格ラベル表示")

// =====================================================
// 保存用
// =====================================================
var line[]  lines  = array.new_line()
var label[] labels = array.new_label()

// =====================================================
// 削除関数
// =====================================================
f_clearAll() =>

    int lineCount = array.size(lines)

    if lineCount > 0
        for i = 0 to lineCount - 1
            line.delete(array.get(lines, i))

    array.clear(lines)

    int labelCount = array.size(labels)

    if labelCount > 0
        for i = 0 to labelCount - 1
            label.delete(array.get(labels, i))

    array.clear(labels)

// =====================================================
// メイン
// =====================================================
if barstate.islast

    // 古い描画削除
    f_clearAll()

    float price = startPrice

    while price <= endPrice

        // =========================
        // 00ライン判定
        // =========================
        bool isMajor = math.round(price) == price

        color lineColor = isMajor ? majorColor : minorColor
        int lineWidth   = isMajor ? majorWidth : minorWidth

        // =========================
        // 実線ライン描画
        // =========================
        line newLine = line.new(
             x1 = bar_index,
             y1 = price,
             x2 = bar_index + futureBars,
             y2 = price,
             extend = extend.none,
             color = lineColor,
             width = lineWidth,
             style = line.style_solid
         )

        array.push(lines, newLine)

        // =========================
        // ラベル表示
        // =========================
        if showLabels

            string textValue = str.tostring(price)

            label newLabel = label.new(
                 x = bar_index + futureBars,
                 y = price,
                 text = textValue,
                 style = label.style_label_left,
                 textcolor = color.white,
                 color = color.new(color.black, 80),
                 size = size.small
             )

            array.push(labels, newLabel)

        // 次の価格
        price += stepSize
