//@version=6
strategy(
     "KiriBan REAL FIX",
     overlay = true,
     pyramiding = 0,
     initial_capital = 100000
)

// ========================================
// 設定
// ========================================
stepSize = input.float(1.0, "キリ番間隔")
tpPips   = input.int(30, "利確pips")
slPips   = input.int(30, "損切pips")

// USDJPY想定
pipValue = 0.01

tp = tpPips * pipValue
sl = slPips * pipValue

// ========================================
// キリ番計算
// ========================================
float level = math.round(close / stepSize) * stepSize

// ========================================
// ライン表示
// ========================================
line.new(
     bar_index,
     level,
     bar_index + 20,
     level,
     color = color.red,
     width = 1
)

// ========================================
// 一度使ったライン管理
// ========================================
var float usedLevel = na

// ========================================
// ライン解放条件
// ========================================
if not na(usedLevel)

    if close >= usedLevel + stepSize or close <= usedLevel - stepSize
        usedLevel := na

// ========================================
// ロング条件
// 上から下へタッチ
// ========================================
longSignal =
     low <= level and
     open > level and
     close > level

// ========================================
// ショート条件
// 下から上へタッチ
// ========================================
shortSignal =
     high >= level and
     open < level and
     close < level

// ========================================
// ロング
// ========================================
if longSignal and strategy.position_size == 0

    if na(usedLevel) or usedLevel != level

        strategy.entry(
             "Long",
             strategy.long,
             limit = level
         )

        usedLevel := level

// ========================================
// ショート
// ========================================
if shortSignal and strategy.position_size == 0

    if na(usedLevel) or usedLevel != level

        strategy.entry(
             "Short",
             strategy.short,
             limit = level
         )

        usedLevel := level

// ========================================
// ロング決済
// ========================================
if strategy.position_size > 0

    strategy.exit(
         "Long Exit",
         from_entry = "Long",
         limit = strategy.position_avg_price + tp,
         stop  = strategy.position_avg_price - sl
     )

// ========================================
// ショート決済
// ========================================
if strategy.position_size < 0

    strategy.exit(
         "Short Exit",
         from_entry = "Short",
         limit = strategy.position_avg_price - tp,
         stop  = strategy.position_avg_price + sl
     )
